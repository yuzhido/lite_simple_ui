# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# 数据库类型：mysql, postgres, sqlite
DB_TYPE=sqlite

# SQLite Configuration (开发环境推荐)
SQLITE_STORAGE=./database.sqlite

# MySQL Configuration (生产环境推荐)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mock_data_db
MYSQL_USER=root
MYSQL_PASSWORD=

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mock_data_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# CORS Configuration
CORS_ORIGIN=*
